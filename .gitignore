# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Environment variables
.env
.env.*
!.env.example

# Processed media & temporary storage
backend/storage/uploads/*
backend/storage/outputs/*
backend/storage/frames/*
backend/storage/models/*.task
# One line per adjudicated rep, appended forever. Runtime data, never source.
backend/storage/adjudications/*
!backend/storage/uploads/.gitkeep
!backend/storage/outputs/.gitkeep
!backend/storage/frames/.gitkeep
!backend/storage/models/.gitkeep

# Node / Expo / React Native
node_modules/
.expo/
dist/
web-build/
android/
ios/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Logs & OS
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.agent-handoff.md
