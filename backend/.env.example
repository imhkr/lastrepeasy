# Gemini API Key for Multimodal Workout Cue & Phase Extraction
# Get one at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Coarena Model API (OpenAI-compatible) used by the live coach adjudicator.
# Keys are rotated by app/services/keypool.py; never ship these to the app.
COARENA_BASE_URL=https://coarena.ai/api/v1
COARENA_ADJUDICATE_MODEL=gpt-6-luna
COARENA_VISION_MODEL=gemini-3-8-flash
COARENA_API_KEY_1=your_coarena_key_1
COARENA_API_KEY_2=your_coarena_key_2
COARENA_API_KEY_3=your_coarena_key_3
COARENA_API_KEY_4=your_coarena_key_4

# Server Config
HOST=0.0.0.0
PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
