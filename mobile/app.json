{
  "expo": {
    "name": "LastRepEasy",
    "slug": "lastrepeasy",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "lastrepeasy",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "com.lastrepeasy.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0F17"
      },
      "intentFilters": [
        {
          "action": "SEND",
          "data": [
            {
              "mimeType": "text/plain"
            },
            {
              "mimeType": "video/*"
            }
          ],
          "category": [
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow LastRepEasy to access your photos and videos for progress pictures and form checks."
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F17"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
